rules_version = '2';

// Regras de Firestore para XestorDeTarefas.
// Publícaas en Firebase Console > Firestore Database > Regras (ou `firebase deploy --only firestore:rules`).
//
// - Só se pode ler e escribir con sesión iniciada en Firebase Authentication.
// - Os usuarios xa vinculados a unha conta (teñen uid) non poden gardar contrasinal.
// - O uid dun usuario non se pode cambiar unha vez posto, e só se pode poñer o propio
//   (ninguén pode apropiarse dun usuario que xa é doutra conta).
//   Excepción: un usuario novo (create) pode levar o uid doutra conta, que é o que fai
//   un admin ao dar de alta a alguén.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function senContrasinalSeVinculado() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == ''
        || !('contrasenha' in request.resource.data);
    }

    function uidValido() {
      return ('uid' in resource.data && resource.data.uid != '')
        ? request.resource.data.get('uid', '') == resource.data.uid
        : (request.resource.data.get('uid', '') == ''
            || request.resource.data.uid == request.auth.uid);
    }

    // Documento base (v1, só lectura para a migración) e as súas coleccións.
    match /tarefas-shared/{base} {
      allow read, write: if autenticado();

      match /usuarios/{usuarioId} {
        allow read: if autenticado();
        allow create: if autenticado() && senContrasinalSeVinculado();
        allow update: if autenticado() && senContrasinalSeVinculado() && uidValido();
        allow delete: if autenticado();
      }

      match /tarefas/{id} {
        allow read, write: if autenticado();
      }

      match /proxectos/{id} {
        allow read, write: if autenticado();
      }

      match /notas/{id} {
        allow read, write: if autenticado();
      }

      match /meta/{id} {
        allow read, write: if autenticado();
      }
    }
  }
}
